# =====================================================================
#  Fișier de exemplu pentru variabilele de mediu (secrete + setări).
#  Copiază-l în ".env" și completează valorile:  cp .env.example .env
# =====================================================================

# --- Baza de date ---
# Pentru LOCAL (SQLite) lasă rândul de mai jos așa cum e:
DATABASE_URL="file:./dev.db"
#
# Pentru ONLINE (Vercel + Postgres) înlocuiește cu ceva de forma:
# DATABASE_URL="postgresql://user:parola@host:5432/numebd?sslmode=require"
# (și schimbă în prisma/schema.prisma  provider = "postgresql")

# --- Autentificare admin ---
# Parola cu care intri în panoul de administrare (/admin).
# SCHIMB-O cu una a ta, greu de ghicit!
ADMIN_PASSWORD="schimba-ma-123"

# Cheie secretă folosită pentru semnarea sesiunii de login.
# Pune un șir lung, aleator (min. 32 de caractere).
SESSION_SECRET="pune-aici-un-sir-secret-lung-si-aleator-min-32-caractere"
